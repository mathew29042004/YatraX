      },
      "targets": [
        {
          "refId": "A",
          "expr": "yatrax_trains_running",
          "legendFormat": "running"
        },
        {
          "refId": "B",
          "expr": "yatrax_trains_late",
          "legendFormat": "late 15+ min"
        }
      ]
    },
    {
      "id": 206,
      "type": "timeseries",
      "title": "Passenger alerts from live trains",
      "gridPos": {
        "x": 12,
        "y": 50,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
